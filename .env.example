# Atlas environment configuration.
# Copy to `.env` and fill in. Every value is optional at import time —
# core/config.py falls back to None for secrets, and `validate_config()`
# prints a warning for any key that is still unset.
#
# NOTE: core/config.py loads this file automatically the first time it is
# imported — no shell exports needed. Variables already set in the real
# environment take precedence over the values below.

# --- Search ---------------------------------------------------------------
# Self-hosted SearXNG instance. Defaults to http://localhost:8888
SEARXNG_URL=http://localhost:8888
# Optional. Without these, Bravo/Exa search providers are skipped.
BRAVE_API_KEY=
EXA_API_KEY=

# --- Trading (Alpaca) -----------------------------------------------------
# Leave blank to run with the trading module disabled.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- System ---------------------------------------------------------------
# City used for the morning briefing. Defaults to London.
WEATHER_CITY=London
